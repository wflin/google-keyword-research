# Local development environment variables.
# Copy this file to .env for local development. Never commit .env or real secrets.
# The values below are for local development only.

# PostgreSQL (local development only)
POSTGRES_DB=keyword_research
POSTGRES_USER=keyword_research
POSTGRES_PASSWORD=keyword_research_dev

# Connection URL for tools running on the host machine (published port 5432).
# Reserved for later tasks (P0-006 / P0-007).
# Containers on the project network must use the service name instead of localhost:
# postgresql://keyword_research:keyword_research_dev@postgres:5432/keyword_research
DATABASE_URL=postgresql://keyword_research:keyword_research_dev@localhost:5432/keyword_research
